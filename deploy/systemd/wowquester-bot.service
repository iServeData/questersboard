# wowquester-bot: Discord interactions (buttons, slash commands)
# Same config (/etc/wowquester/config.toml) as the other two units; only the credentials differ.
[Unit]
Description=QuestersBoard Discord interactions (buttons, slash commands)
Documentation=file:/opt/wowquester/current/README.md
Wants=network-online.target
After=network-online.target time-sync.target postgresql.service
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=exec
User=wowquester
Group=wowquester
Environment=PYTHONUNBUFFERED=1 WOWQUESTER_CONFIG=/etc/wowquester/config.toml
# Host-key encrypted credentials from /etc/credstore.encrypted/wowquester.<name>; least privilege per unit.
ImportCredential=wowquester.db-app-password
ImportCredential=wowquester.discord-bot-token
ImportCredential=wowquester.field-key
ExecStartPre=/opt/wowquester/current/venv/bin/wowquester-admin check-config --quiet
ExecStart=/opt/wowquester/current/venv/bin/python -E -s -B -m wowquester.bot.client
WorkingDirectory=/var/lib/wowquester
StateDirectory=wowquester
StateDirectoryMode=0750
Restart=on-failure
RestartPreventExitStatus=78
RestartSec=10
RestartSteps=6
RestartMaxDelaySec=300
TimeoutStopSec=30

ReadOnlyPaths=/etc/wowquester
# Other services on the host: hide their config/state with a drop-in (docs/install.md, "Isolation drop-in").
InaccessiblePaths=-/etc/credstore.encrypted -/srv -/root

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RemoveIPC=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0077
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @mount @debug @cpu-emulation @obsolete @raw-io @reboot @swap
SystemCallErrorNumber=EPERM
DevicePolicy=closed
LimitNOFILE=1024
MemoryMax=256M
TasksMax=64
CPUQuota=50%
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
