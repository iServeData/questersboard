# QuestersBoard credentials — names only, NO VALUES. Production does not use this file:
# each value is stored host-key encrypted as /etc/credstore.encrypted/questersboard.<name> and imported
# per unit (ImportCredential=). Install one with (value read from stdin, never on the command line):
#   sudo systemd-creds encrypt --with-key=host --name=questersboard.<name> - /etc/credstore.encrypted/questersboard.<name>
# If systemd credentials are unavailable, the fallback is /etc/questersboard/secrets.env (root:questersboard 0640)
# loaded with EnvironmentFile= using the variable names below.
#
# name                     used by           variable (fallback / local dev)
# discord-bot-token        web bot worker    QUESTERSBOARD_SECRET_DISCORD_BOT_TOKEN=
# discord-client-secret    web               QUESTERSBOARD_SECRET_DISCORD_CLIENT_SECRET=
# field-key                web bot worker    QUESTERSBOARD_SECRET_FIELD_KEY=          # 32-byte urlsafe base64 (Fernet)
# db-app-password          web bot           QUESTERSBOARD_SECRET_DB_APP_PASSWORD=
# db-worker-password       worker            QUESTERSBOARD_SECRET_DB_WORKER_PASSWORD=
# db-admin-password        admin CLI only    QUESTERSBOARD_SECRET_DB_ADMIN_PASSWORD=
# blizzard-client-id       web worker        QUESTERSBOARD_SECRET_BLIZZARD_CLIENT_ID=
# blizzard-client-secret   web worker        QUESTERSBOARD_SECRET_BLIZZARD_CLIENT_SECRET=
# ai-api-key               worker (optional) QUESTERSBOARD_SECRET_AI_API_KEY=
