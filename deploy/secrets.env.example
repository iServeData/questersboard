# WoWQuester credentials — names only, NO VALUES. Production does not use this file:
# each value is stored host-key encrypted as /etc/credstore.encrypted/wowquester.<name> and imported
# per unit (ImportCredential=). Install one with (value read from stdin, never on the command line):
#   sudo systemd-creds encrypt --name=wowquester.<name> - /etc/credstore.encrypted/wowquester.<name>
# If systemd credentials are unavailable, the fallback is /etc/wowquester/secrets.env (root:wowquester 0640)
# loaded with EnvironmentFile= using the variable names below.
#
# name                     used by           variable (fallback / local dev)
# discord-bot-token        web bot worker    WOWQUESTER_SECRET_DISCORD_BOT_TOKEN=
# discord-client-secret    web               WOWQUESTER_SECRET_DISCORD_CLIENT_SECRET=
# field-key                web bot worker    WOWQUESTER_SECRET_FIELD_KEY=          # 32-byte urlsafe base64 (Fernet)
# db-app-password          web bot           WOWQUESTER_SECRET_DB_APP_PASSWORD=
# db-worker-password       worker            WOWQUESTER_SECRET_DB_WORKER_PASSWORD=
# db-admin-password        admin CLI only    WOWQUESTER_SECRET_DB_ADMIN_PASSWORD=
# blizzard-client-id       web worker        WOWQUESTER_SECRET_BLIZZARD_CLIENT_ID=
# blizzard-client-secret   web worker        WOWQUESTER_SECRET_BLIZZARD_CLIENT_SECRET=
# ai-api-key               worker (optional) WOWQUESTER_SECRET_AI_API_KEY=
